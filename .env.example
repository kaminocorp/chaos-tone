# Virtual DJ agent — DeepSeek Harness runtime routed through OpenRouter.
# Without OPENROUTER_API_KEY the agent panel reports "offline"; the deck,
# pads and /api/dj/* keep working. See docs/executing/virtual-dj-agent.md.
OPENROUTER_API_KEY=

# Any OpenRouter model id that supports tool calling (default below).
VDJ_AGENT_MODEL=deepseek/deepseek-v4-flash

# Reasoning effort for the model: off | low | medium | high | default.
# "off" keeps replies fast enough for a live room.
VDJ_AGENT_REASONING=off

# Optional: where the harness keeps its home (sessions, credentials cache).
# Defaults to <repo>/.dsh (gitignored).
# VDJ_DSH_HOME=

# Optional: point the OpenRouter route at another OpenAI-compatible endpoint
# (the smoke script uses this for its fake server).
# VDJ_OPENROUTER_BASE_URL=
